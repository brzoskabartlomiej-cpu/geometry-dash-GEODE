{
  "name": "geo-dash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source Geometry Dash-style platformer (Steam-free) with a Geode-inspired mod system.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "validate": "node scripts/validate-configs.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "icons": "npx tauri icon assets/icon.png",
    "make-icon": "python3 scripts/make-icon.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
